# Vendor kernel selected by config/sources/families/rk35xx.conf.
FILESEXTRAPATHS:prepend := "${THISDIR}/files/kickpi-k7:"
SRCREV:kickpi-k7 = "372ce582b94a3360a29727c3c49c88bb7509da22"
SRC_URI:kickpi-k7 = " \
    git://github.com/armbian/linux-rockchip.git;protocol=https;branch=rk-6.1-rkr5.1 \
    file://defconfig \
    file://004-add-PHY-for-MAE0621A-Q2C.patch \
    file://rk3576-kickpi-k7.dts;subdir=kickpi-k7 \
    file://rk3576-kickpi-k7-cam0.dtsi;subdir=kickpi-k7 \
    file://rk3576-kickpi-k7-cam1.dtsi;subdir=kickpi-k7 \
    file://rk3576-kickpi-k7-cam3.dtsi;subdir=kickpi-k7 \
"
# Use the vendor full config, not the generic Rockchip in-tree defconfig.
KBUILD_DEFCONFIG:kickpi-k7 = "kickpi_k7_defconfig"
KCONFIG_MODE:kickpi-k7 = "--alldefconfig"

do_kickpi_sources() {
    install -m 0644 ${UNPACKDIR}/defconfig ${S}/arch/arm64/configs/kickpi_k7_defconfig
    dts_dir="${S}/arch/arm64/boot/dts/rockchip"
    install -m 0644 ${UNPACKDIR}/kickpi-k7/*.dts* "${dts_dir}/"
    if ! grep -q 'rk3576-kickpi-k7\.dtb' "${dts_dir}/Makefile"; then
        echo 'dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3576-kickpi-k7.dtb' >> "${dts_dir}/Makefile"
    fi
}

addtask kickpi_sources after do_kernel_checkout before do_kernel_metadata

# Serial bring-up: use only the explicitly selected PHY patch above.
# Disable BSP auto-injection of filesystem fallback and DRM display patches.
PATCHPATH:kickpi-k7 = ""
