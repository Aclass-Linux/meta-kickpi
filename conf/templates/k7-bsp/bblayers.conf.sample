LCONF_VERSION = "7"
POKY_BBLAYERS_CONF_VERSION = "2"
BBPATH = "${TOPDIR}"
BBFILES ?= ""

# 构建目录与 sources 同级。板级验证启用 OE-Core、Poky 和 K7 BSP。
WORKSPACE_SOURCES = "${TOPDIR}/../sources"
BBLAYERS ?= " \
    ${WORKSPACE_SOURCES}/openembedded-core/meta \
    ${WORKSPACE_SOURCES}/meta-yocto/meta-poky \
    ${WORKSPACE_SOURCES}/meta-kickpi \
"

# 官方 iceoryx2 层由 repo 同步，确认支持当前 Yocto 分支后可启用。
#BBLAYERS += "${WORKSPACE_SOURCES}/meta-rust-bin ${WORKSPACE_SOURCES}/meta-iceoryx2"
