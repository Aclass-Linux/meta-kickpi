/*
 * KICKPI K7 Linux board configuration.
 * Board overrides for the Rockchip BSP RK3576 SoC device tree.
 * K7 topology cross-checked against the vendor rk3576-kickpi-k7.dts.
 * Keep boot firmware power rails; voltage switching/HS200 require board validation.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "rk3576.dtsi"

/ {
	model = "KICKPI K7";
	compatible = "kickpi,k7", "rockchip,rk3576";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};
};

&gmac0 {
	/* The PHY adds the RX delay, and the MAC adds the TX delay. */
	phy-mode = "rgmii-rxid";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&eth0m0_miim &eth0m0_tx_bus2 &eth0m0_rx_bus2
		     &eth0m0_rgmii_clk &eth0m0_rgmii_bus>;
	tx_delay = <0x21>;
	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&gmac1 {
	phy-mode = "rgmii-rxid";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio3 RK_PA3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&eth1m0_miim &eth1m0_tx_bus2 &eth1m0_rx_bus2
		     &eth1m0_rgmii_clk &eth1m0_rgmii_bus>;
	tx_delay = <0x20>;
	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

/* The two PHYs use address 0 on separate MDIO buses. */
&mdio0 {
	rgmii_phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
		clocks = <&cru REFCLKO25M_GMAC0_OUT>;
	};
};

&mdio1 {
	rgmii_phy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
		clocks = <&cru REFCLKO25M_GMAC1_OUT>;
	};
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&sdmmc {
	/* Vendor K7 routes CLK/CMD/CD/DATA; do not inherit generic PWREN. */
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	max-frequency = <50000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&usb_drd0_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	status = "okay";
};
