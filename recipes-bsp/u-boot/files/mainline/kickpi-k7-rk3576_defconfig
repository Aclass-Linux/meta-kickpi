# KICKPI K7（RK3576）主线 U-Boot 配置基线。
# 由 u-boot-k7-mainline_git.bb 的 do_configure:prepend 装入 configs/，
# make kickpi-k7-rk3576_defconfig 时作为基线，未列出的选项取 Kconfig 默认值。
# 适配范围：串口、SD/eMMC、USB；其余外设未验证。
# K7 禁止启用 CONFIG_SPL_AB（单 rootfs，配方 do_compile 校验）。

# --- 架构与 SoC ---
CONFIG_ARM=y
# RK3576 出厂 BootROM 已完成基本初始化，SPL 跳过低级初始化。
CONFIG_SKIP_LOWLEVEL_INIT=y
# ARM 通用定时器频率（RK3576 24 MHz 输入时钟）。
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_ARCH_ROCKCHIP=y
# 板级设备树名，不含 .dtb 后缀；同时决定 binman 打包哪个 DTB。
CONFIG_DEFAULT_DEVICE_TREE="rk3576-kickpi-k7"
CONFIG_ROCKCHIP_RK3576=y
# 内核与 DTB 的默认加载地址（RK3576 DDR 映射）。
CONFIG_SYS_LOAD_ADDR=0x40c00800

# --- 调试串口（UART0，0x2AD40000；K7 原理图调试口接 uart0）---
# 与内核 DTS chosen/stdout-path（serial0:1500000n8）及机器配置
# K7_CONSOLE_DEVICE=ttyS0 对应同一物理串口，三方必须一致。
# 以下各项共同定义早期 console（SPL/TPL 阶段的 printf 就走它）：
#   BASE=uart0 寄存器基址（SoC dtsi 固定值）；
#   CLOCK=波特率时钟源，接 24 MHz 晶振（同 xin24m，见 CONFIG_COUNTER_FREQUENCY）；
#   SHIFT=2 → 寄存器步长 4 字节（2^2），MEM32 → 32 位访问，
#   两者都是 Synopsys DW APB UART IP 的访问特性（dtsi compatible 可证）。
CONFIG_DEBUG_UART_BASE=0x2AD40000
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_DEBUG_UART=y
CONFIG_BAUDRATE=1500000
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_SYS_NS16550_MEM32=y

# --- 启动设备树传递 ---
# 传给内核的 DTB 相对路径（extlinux 也能覆盖）。
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3576-kickpi-k7.dtb"

# --- SPL 尺寸与布局约束 ---
# SPL 上限 256 KiB：idbloader.img = TPL+SPL，受 K7_IDB_MAX_BYTES（配方编译期校验）。
CONFIG_SPL_MAX_SIZE=0x40000
# 不以原始二进制方式加载 SPL（RK3576 走 TPL 流程）。
# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
# SPL 内精简设备树：删除内核不需要的属性，缩小 SPL 体积。
CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
# 使用 SoC DTS 而非 OF_UPSTREAM 通用树，配合本配方 -u-boot.dtsi。
# CONFIG_OF_UPSTREAM is not set

# --- eMMC/SD 控制器（DW 与 SDHCI 两套驱动并存）---
CONFIG_SUPPORT_EMMC_RPMB=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_ROCKCHIP=y

# --- USB（DWC3）与 Rockusb 烧录支持 ---
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GENERIC=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_ROCKUSB=y
CONFIG_CMD_ROCKUSB=y
CONFIG_CMD_USB_MASS_STORAGE=y

# --- 启动流程：bootstd + extlinux ---
# K7 的内核加载方式：extlinux/extlinux.conf，不用 Rockchip vendor boot 流程。
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_BOOTMETH_EXTLINUX=y
# 读取 extlinux.conf 所需的 ext4 支持。
CONFIG_CMD_EXT4=y

# --- 精简：关闭用不到的功能，缩小体积 ---
# CONFIG_BOOTMETH_VBE is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_SPL_DOS_PARTITION is not set
CONFIG_NO_NET=y
# CONFIG_ADC is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_CMD_SETEXPR is not set

# --- 常用调试命令 ---
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_MEMINFO_MAP=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_GPT=y
CONFIG_CMD_MISC=y
CONFIG_CMD_MMC=y
CONFIG_CMD_RNG=y

# --- 系统复位与杂项 ---
# 通过 PSCI 系统调用复位（依赖 BL31，即 FIT 中的 ATF）。
CONFIG_SYSRESET_PSCI=y
CONFIG_ROCKCHIP_GPIO=y
CONFIG_ERRNO_STR=y
